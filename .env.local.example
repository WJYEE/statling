# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). Without these, login
# is disabled but the rest of the app still works — see lib/supabase/client.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used for OAuth/email redirect URLs, share links, OG/Twitter metadata, and
# campaign URLs (lib/env/site-url.ts). The value below is a local-dev
# default only — Vercel Production/Preview environment variables MUST set
# this to the real deployed domain (e.g. https://statling.app); leaving it
# unset there falls back to Vercel's own deployment URL, not this literal,
# but an explicit value here is still the recommended source of truth. Never
# copy this http://localhost:3000 value into a Production/Preview env var.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GA4 Measurement ID (Admin -> Data Streams -> your web stream, format
# G-XXXXXXXXXX). Without this, the GA4 tag (components/analytics/google-
# analytics.tsx) doesn't render at all. Point this at a separate "test"
# GA4 property locally / in Preview so QA traffic doesn't mix into
# Production reports.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# PostHog project API key (Project Settings -> Project API Key in the
# PostHog dashboard, format phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX).
# NOT wired into any code yet — placeholder for when PostHog is integrated.
NEXT_PUBLIC_POSTHOG_KEY=phc_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# PostHog ingestion host — https://us.i.posthog.com (US cloud, default) or
# https://eu.i.posthog.com (EU cloud), or your self-hosted instance's URL.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
